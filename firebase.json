{
  "hosting": [
    {
      "target": "main",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "target": "legacy",
      "public": "public",
      "ignore": ["**"],
      "redirects": [
        { "source": "**", "destination": "https://matematik-1-6.web.app", "type": 301 }
      ]
    }
  ]
}
